-- โหลด Fluent UI Library
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- สร้างหน้าต่างหลักชื่อ Sowlozz8💩 (โทนสีเขียว)
local Window = Fluent:CreateWindow({
    Title = "Sowlozz8💩",
    SubTitle = "Delta Executor Hub",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Green",
    MinimizeKey = Enum.KeyCode.LeftControl -- กด Left Control เพื่อซ่อน/โชว์เมนู
})

-- ==========================================
-- ช่องที่ 1: สาย AFK & ยูทิลิตี้ (AFK & Utilities)
-- ==========================================
local Tab1 = Window:AddTab({ Title = "สาย AFK", Icon = "coffee" })

-- 1. ลดอาการค้าง/แลค
Tab1:AddButton({
    Title = "1. ลดอาการค้าง/แลค (FPS Boost)",
    Callback = function()
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("BasePart") then v.Material = Enum.Material.SmoothPlastic v.Reflectance = 0
            elseif v:IsA("Decal") or v:IsA("Texture") then v:Destroy()
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then v.Enabled = false end
        end
        game:GetService("Lighting").GlobalShadows = false
    end
})

-- 2. ป้องกันโดนเตะ AFK 20 นาที
local AntiAFK = false
Tab1:AddToggle("AntiAFK", {
    Title = "2. ป้องกันโดนเตะ AFK (Anti-AFK)",
    Default = false,
    Callback = function(Value) AntiAFK = Value end
})
game:GetService("Players").LocalPlayer.Idled:Connect(function()
    if AntiAFK then
        game:GetService("VirtualUser"):CaptureController()
        game:GetService("VirtualUser"):ClickButton2(Vector2.new())
    end
end)

-- 3. อมตะเบื้องต้น (Godmode Client)
Tab1:AddButton({
    Title = "3. ลบ ForceField / รีเซ็ต Humanoid",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.MaxHealth = math.huge
            char.Humanoid.Health = math.huge
        end
    end
})

-- 4. คัดลอกไอเทมจากมือผู้เล่นอื่น
Tab1:AddButton({
    Title = "4. คัดลอก Tool จากผู้เล่นใกล้เคียง",
    Callback = function() end
})

-- 5. กระโดดไม่จำกัด (Infinite Jump)
local InfJump = false
Tab1:AddToggle("InfJump", {
    Title = "5. กระโดดไม่จำกัด (Infinite Jump)",
    Default = false,
    Callback = function(Value) InfJump = Value end
})
game:GetService("UserInputService").JumpRequest:Connect(function()
    if InfJump then
        game.Players.LocalPlayer.Character:FindFirstChildOfClass('Humanoid'):ChangeState("Jumping")
    end
end)

-- 6. Auto Clicker
local AutoClick = false
Tab1:AddToggle("AutoClick", {
    Title = "6. Auto Clicker",
    Default = false,
